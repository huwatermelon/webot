# Server
WEBOT_HOST=127.0.0.1
WEBOT_PORT=18120
WEBOT_CHANNELS=none
WEBOT_OUTBOUND_MODE=dry-run
WEBOT_LOG_LEVEL=info
WEBOT_STATE_DIR=./state

# Identity and trigger policy
WEBOT_SELF_WXID=
WEBOT_BOT_NAMES=Webot
WEBOT_GROUP_TRIGGERS=webot,机器人
WEBOT_ALLOWED_CHAT_IDS=
WEBOT_ALLOWED_SENDER_IDS=
WEBOT_BLOCKED_SENDER_IDS=
WEBOT_ALLOW_SELF=false

# Assistant: echo | webhook | openai-compatible
WEBOT_ASSISTANT=echo
WEBOT_SYSTEM_PROMPT=You are a concise and helpful WeChat assistant.
WEBOT_HISTORY_TURNS=12
WEBOT_ASSISTANT_TIMEOUT_MS=60000

# Webhook assistant
WEBOT_ASSISTANT_WEBHOOK_URL=
WEBOT_ASSISTANT_WEBHOOK_TOKEN=

# OpenAI-compatible chat completions
WEBOT_LLM_BASE_URL=https://api.openai.com/v1
WEBOT_LLM_API_KEY=
WEBOT_LLM_MODEL=

# Hook / OneBot
WEBOT_HOOK_API_URL=http://127.0.0.1:58080
WEBOT_HOOK_ACCESS_TOKEN=
WEBOT_HOOK_CALLBACK_SECRET=

# Pad protocol
WEBOT_PAD_SOURCES_FILE=
WEBOT_PAD_MAIN_ACCESS_TOKEN=
WEBOT_PAD_SMALL_ACCESS_TOKEN=
WEBOT_PAD_WS_URL=
WEBOT_PAD_API_URL=http://127.0.0.1:8059
WEBOT_PAD_ACCESS_TOKEN=
WEBOT_PAD_CALLBACK_SECRET=
WEBOT_PAD_REQUIRE_WRITE_CONFIRMATION=false
